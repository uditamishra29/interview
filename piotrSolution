def find_holiday_suppression(findings, exchange_holidays, run_date):
    # Filter exchange_holidays for the run_date
    holidays_today = exchange_holidays[exchange_holidays['date'] == run_date]       #run_date is cuurent date

    # Check if any findings match the exchanges that have holidays today
    suppressed_findings = findings[findings['exchange'].isin(holidays_today['exchange'])]

    if not suppressed_findings.empty:
        print(f"Suppressed findings due to holidays on {run_date}:")
        print(suppressed_findings)
    else:
        print(f"No suppressed findings due to holidays on {run_date}.")

    return suppressed_findings


#De-duplication: collapse findings that are the same observation emitted more than once.

def deduplicate_findings(findings):
    # Drop duplicates based on 'run_date', 'check_id', 'instrument', and 'exchange'
    deduplicated_findings = findings.drop_duplicates(subset=['run_date', 'check_id', 'instrument', 'exchange', 'upstream_job'], keep='first')

    return deduplicated_findings

    
