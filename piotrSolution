
import pandas as pd
import yaml

def load_data(folder,run_date):

    #  reading findings.json 
    findings = pd.read_json(f"{folder}/findings.json", lines=True)


    findings=findings[findings[run_date]==run_date].copy()


    # reading instruments.csv metadata 
    instruments = pd.read_csv(f"{folder}/instruments.csv")

    # reading dev_labels.csv metadata 
    dev_labels = pd.read_csv(f"{folder}/dev_labels.csv")

    # reading exchange_holidays.csv metadata
    exchange_holidays = pd.read_csv(f"{folder}/exchange_holidays.csv")


    with open('known_issues.yaml', 'r', encoding='utf-8') as file:
    # Safely load the YAML contents into a Python dictionary or list
       known_issues = yaml.safe_load(file)

    with open('routing.yaml', 'r', encoding='utf-8') as file:
    # Safely load the YAML contents into a Python dictionary or list
       routing = yaml.safe_load(file)

    return findings, instruments, dev_labels,exchange_holidays, known_issues, routing




