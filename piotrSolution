def get_known_issues(findings, known_issues,run_date):
    
    # check for each known issue in the findings
    for issue in known_issues:
        if issue['expires'] < run_date:
            continue  # Skip expired issues

        # check on check_id and instrument if specified
        matches= all(
            findings.get(key)==value
        for key, value in issue['match'].items())
 
        if matches:
            print(f"Found known issue: {issue['id']}")
            # removing this finding from the findings DataFrame
            findings.drop(findings[(findings[list(issue['match'].keys())[0]] == list(issue['match'].values())[0])].index, inplace=True)
            


    return None  # Return None if no known issues are found



