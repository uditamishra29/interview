"""first finding deterministic suppression, de-duplication, grouping and routing."""

import argparse
import json
from datetime import date
from pathlib import Path

import pandas as pd
import yaml


# Read the files needed for Stage 1.
def load_data(folder, run_date):
    folder = Path(folder)
    date.fromisoformat(run_date)  # Checking for  YYYY-MM-DD format.

    findings = pd.read_json(folder / "findings.jsonl", lines=True)
    findings = findings[findings["run_date"].astype(str) == run_date].copy()

    instruments = pd.read_csv(folder / "instruments.csv", dtype=str)
    holidays = pd.read_csv(folder / "exchange_holidays.csv", dtype=str)

    with open(folder / "known_issues.yaml", encoding="utf-8") as file:
        known_issues = yaml.safe_load(file) or []

    with open(folder / "routing.yaml", encoding="utf-8") as file:
        routing = yaml.safe_load(file) or {}

    # Add the instrument's exchange so we can check holidays.
    findings = findings.merge(
        instruments[["symbol", "exchange"]],
        left_on="instrument",
        right_on="symbol",
        how="left",
        validate="many_to_one",
    ).drop(columns="symbol")

    # Keep tracking columns: do not delete findings.
    findings["disposition"] = "pending"
    findings["reason_code"] = None
    findings["reason"] = None
    findings["ticket"] = None
    findings["duplicate_of"] = None
    findings["group_id"] = None

    return findings, holidays, known_issues, routing


# Suppress stale-price and missing-row checks only when the correct exchange was closed.

def find_holiday_suppression(findings, holidays, run_date):

    # Get exchanges closed on the run date
    today_holidays = holidays[holidays["date"] == run_date]

    # Loop through each finding
    for index, finding in findings.iterrows():

        # Skip already processed findings
        if finding["disposition"] != "pending":
            continue

        # Only suppress stale price and missing row
        if finding["check_id"] not in ["DQ.STALE_PRICE", "DQ.MISSING_ROW"]:
            continue

        # Get exchange
        exchange = finding["exchange"]

        # Find holiday record for this exchange
        holiday_match = today_holidays[today_holidays["exchange"] == exchange]

        # If exchange is closed, suppress the finding
        if not holiday_match.empty:

            # Get holiday name from matching row
            holiday_name = holiday_match.iloc[0]["name"]

            findings.at[index, "disposition"] = "suppressed"
            findings.at[index, "reason_code"] = "exchange_holiday"
            findings.at[index, "reason"] = (
                f"{exchange} was closed on {run_date}: {holiday_name}"
            )

    return findings


# - id: KI-01
#   match: {check_id: DQ.PRICE_JUMP, instrument: XT}
#   reason: "XT settlements are yield-quoted"
#   ticket: DATA-412
#   expires: 2025-12-31

# Suppress only if the rule is active and every match field is equal.


def get_known_issues(findings, known_issues, run_date):

    # Loop through each known issue
    for issue in known_issues:

        # Check expiry date
        expires = pd.to_datetime(issue["expires"]).date()
        if expires < pd.to_datetime(run_date).date():
            continue

        # Get matching conditions from YAML
        match = issue["match"]

        # Check pending findings with matching check_id
        matching = (
            (findings["disposition"] == "pending") &
            (findings["check_id"] == match["check_id"])
        )

        # Check instrument only if specified in YAML
        if "instrument" in match:
            matching = matching & (findings["instrument"] == match["instrument"])

        # Suppress matching findings
        findings.loc[matching, "disposition"] = "suppressed"
        findings.loc[matching, "reason_code"] = f"known_issue:{issue['id']}"
        findings.loc[matching, "reason"] = issue["reason"]
        findings.loc[matching, "ticket"] = issue.get("ticket")

    return findings

# Mark repeated observations, even if the check was run with a different run_id.
def deduplicate_findings(findings):
    columns = [
        "run_date", "check_id", "instrument", "raw_severity",
        "value", "threshold", "message", "upstream_job",
    ]
    first_seen = {}

    for index, row in findings[findings["disposition"] == "pending"].iterrows():
        key = tuple(None if pd.isna(row[col]) else str(row[col]) for col in columns)

        if key in first_seen:
            findings.at[index, "disposition"] = "duplicate"
            findings.at[index, "duplicate_of"] = first_seen[key]
            findings.at[index, "reason_code"] = "duplicate_observation"
            findings.at[index, "reason"] = f"Same observation as {first_seen[key]}"
        else:
            first_seen[key] = row["id"]

    return findings


# Calculate the owning team using the longest matching check_id prefix.
def get_route(check_id, routing):

    # Get routing rules from YAML
    routes = routing.get("routes", {})

    # Get default team
    team = routing.get("default", "triage-human")

    # Store the longest matching prefix
    longest_prefix = ""

    # Loop through each prefix and team
    for prefix, owner in routes.items():

        # Check if check_id starts with this prefix
        if check_id.startswith(prefix):

            # Select the longest matching prefix
            if len(prefix) > len(longest_prefix):

                longest_prefix = prefix
                team = owner

    return team


# Group failed ingest jobs with their missing-row findings; keep other checks separate.

def group_findings(findings, routing):

    #  Find all failed ingest jobs
    active = findings[findings["disposition"] == "pending"]

    failed = active[active["check_id"] == "INGEST.JOB_FAILED"]
    failed_jobs = failed["upstream_job"].dropna().tolist()

    #  Group findings with the same root cause
    group_members = {}

    for index, row in findings.iterrows():

        # Find the owning team
        findings.at[index, "route_to"] = get_route(row["check_id"], routing)

        # Skip suppressed and duplicate findings
        if row["disposition"] != "pending":
            continue

        job = row["upstream_job"]

        # Group missing rows with their failed ingest job
        if pd.notna(job) and job in failed_jobs and row["check_id"] in ["INGEST.JOB_FAILED", "DQ.MISSING_ROW"]:
            root_cause = "ingest_failure:" + job
        else:
            root_cause = "finding:" + row["id"]

        # Create new group if it does not exist
        if root_cause not in group_members:
            group_members[root_cause] = []

        # Add finding index to its group
        group_members[root_cause].append(index)

    # Create issue groups
    groups = []

    for root_cause, indices in group_members.items():

        group_id = "G" + str(len(groups) + 1)

        # Update findings with group ID
        findings.loc[indices, "disposition"] = "issue"
        findings.loc[indices, "group_id"] = group_id

        # Get all findings in this group
        members = findings.loc[indices]

        # Get owning teams
        owners = members["route_to"].unique().tolist()

        if len(owners) == 1:
            owner = owners[0]
        else:
            owner = routing.get("default", "triage-human")

        # Get highest severity (P0 is highest)
        severity = min(members["raw_severity"])

        # Store group information
        groups.append({
            "group_id": group_id,
            "root_cause_key": root_cause,
            "finding_ids": members["id"].tolist(),
            "check_ids": members["check_id"].tolist(),
            "raw_severity": severity,
            "route_to": owner,
            "routing_conflict": len(owners) > 1
        })

    #  Linkingduplicates to original group's ID
    duplicates = findings[findings["disposition"] == "duplicate"]

    for index, row in duplicates.iterrows():

        original = findings[findings["id"] == row["duplicate_of"]]

        if not original.empty:
            findings.at[index, "group_id"] = original.iloc[0]["group_id"]

    return findings, groups



# Write an audit file for Stage 1; LLM fields are intentionally not included.
def save_stage1(findings, groups, output_path, run_date):
    result = {
        "run_date": run_date,
        "stage": "deterministic_only",
        "findings": json.loads(findings.to_json(orient="records")),
        "groups": groups,
    }
    Path(output_path).write_text(json.dumps(result, indent=2), encoding="utf-8")


# Connect all Stage 1 functions through a command-line program.
def main():
    parser = argparse.ArgumentParser(description="Data-quality triage: Stage 1")
    parser.add_argument("--date", required=True, help="Run date, e.g. 2025-11-27")
    parser.add_argument("--folder", default="T002-data", help="Folder containing inputs")
    parser.add_argument("--output", default="stage1_output.json", help="Stage 1 JSON output")
    args = parser.parse_args()

    findings, holidays, known_issues, routing = load_data(args.folder, args.date)
    findings = find_holiday_suppression(findings, holidays, args.date)
    findings = get_known_issues(findings, known_issues, args.date)
    findings = deduplicate_findings(findings)
    findings, groups = group_findings(findings, routing)
    save_stage1(findings, groups, args.output, args.date)

    print(f"Findings: {len(findings)}")
    print(f"Suppressed: {(findings['disposition'] == 'suppressed').sum()}")
    print(f"Duplicates: {(findings['disposition'] == 'duplicate').sum()}")
    print(f"Issue groups: {len(groups)}")
    for group in groups:
        print(f"{group['group_id']}: {group['finding_ids']} -> {group['route_to']}")
    print(f"Saved output to {args.output}")


if __name__ == "__main__":
    main()
